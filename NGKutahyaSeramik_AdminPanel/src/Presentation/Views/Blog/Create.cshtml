@model Presentation.Models.Blog.BlogFormViewModel
@{
    ViewData["Title"] = "Yeni Blog Yazısı";
}

<div class="admin-form-page">
    <div class="admin-form-header">
        <p class="admin-form-description">Yeni blog içeriğinin bilgilerini ve yayın ayarlarını giriniz.</p>
        <a asp-controller="Blog" asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
            <span>Blog Yönetimi'ne Dön</span>
        </a>
    </div>
    <form asp-controller="Blog" asp-action="Create" method="post" enctype="multipart/form-data" class="admin-form-shell">
        @await Html.PartialAsync("_BlogForm", Model)
    </form>
</div>
