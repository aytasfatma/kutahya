@model Presentation.Models.Blog.BlogFormViewModel

<div asp-validation-summary="All" class="alert alert-danger"></div>

<section class="card admin-form-section">
    <div class="card-header">
        <h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">1</span>Temel Bilgiler</h3>
    </div>
    <div class="card-body">
        <div class="admin-form-grid">
            <div class="admin-form-field">
                <label asp-for="BlogCategoryId" class="form-label"></label>
                <select asp-for="BlogCategoryId" asp-items="Model.BlogCategoryOptions" class="form-select"></select>
                <span asp-validation-for="BlogCategoryId" class="text-danger"></span>
            </div>
            <div class="admin-form-field">
                <label asp-for="Author" class="form-label"></label>
                <input asp-for="Author" class="form-control" placeholder="Yazar" />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>
            <div class="admin-form-field">
                <label asp-for="PublishDate" class="form-label"></label>
                <input asp-for="PublishDate" type="date" class="form-control" min="1900-01-01" max="@DateTime.Today.AddYears(5).ToString("yyyy-MM-dd")" />
                <span asp-validation-for="PublishDate" class="text-danger"></span>
            </div>
            <div class="admin-form-field">
                <label class="form-label">TREND</label>
                <label class="form-check mt-3">
                    <input asp-for="IsTrend" class="form-check-input" type="checkbox" />
                    <span class="form-check-label">TREND blog kategorisine taşıyın</span>
                </label>
            </div>
            <div class="admin-form-field">
                <label asp-for="TagsInput" class="form-label"></label>
                <input asp-for="TagsInput" class="form-control" placeholder="banyo, tasarim, trend" />
                <span asp-validation-for="TagsInput" class="text-danger"></span>
                <div class="admin-form-help">Etiketleri virgulle ayirarak girin.</div>
            </div>
            <div class="admin-form-field">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>
    </div>
</section>

<section class="card admin-form-section">
    <div class="card-header">
        <h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">2</span>Gorsel</h3>
    </div>
    <div class="card-body">
        <div class="admin-form-upload">
            @if (Model.ExistingFeaturedImagePath is not null)
            {
                <div class="mb-3">
                    <div class="text-secondary small">Mevcut kapak gorseli</div>
                    <img src="@Model.ExistingFeaturedImagePath" alt="" class="admin-form-preview" />
                </div>
                <label class="form-check mb-3">
                    <input asp-for="RemoveFeaturedImage" class="form-check-input" type="checkbox" />
                    <span class="form-check-label">Kapak gorselini kaldir</span>
                </label>
            }
            <label for="featuredImage" class="form-label">Kapak Gorseli @(Model.ExistingFeaturedImagePath is not null ? "(Degistir, opsiyonel)" : "(opsiyonel)")</label>
            <input type="file" id="featuredImage" name="featuredImage" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            <div class="admin-form-help">Izin verilen formatlar: JPG, JPEG, PNG, WEBP. Maksimum dosya boyutu: 5 MB.</div>
        </div>
        <div class="admin-form-upload mt-4">
            @if (Model.ExistingSecondaryImagePath is not null)
            {
                <div class="mb-3">
                    <div class="text-secondary small">Mevcut ikinci görsel</div>
                    <img src="@Model.ExistingSecondaryImagePath" alt="" class="admin-form-preview" />
                </div>
                <label class="form-check mb-3">
                    <input asp-for="RemoveSecondaryImage" class="form-check-input" type="checkbox" />
                    <span class="form-check-label">İkinci görseli kaldır</span>
                </label>
            }
            <label for="secondaryImage" class="form-label">İkinci Görsel @(Model.ExistingSecondaryImagePath is not null ? "(Değiştir, opsiyonel)" : "(opsiyonel)")</label>
            <input type="file" id="secondaryImage" name="secondaryImage" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            <div class="admin-form-help">Blog detayında içeriğin yanındaki ikinci görsel. Eklenmezse kapak görseli kullanılır. JPG, JPEG, PNG veya WEBP; en fazla 5 MB.</div>
        </div>
    </div>
</section>

<section class="card admin-form-section" x-data="{ selectedLanguage: 'TR' }">
    <div class="card-header">
        <h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">3</span>Ceviriler / Icerik ve SEO</h3>
    </div>
    <div class="card-body">
        <p class="admin-form-section-intro">Kullanmak istediğiniz içerik dilini seçerek ilgili alanları doldurun.</p>
        <div class="admin-form-language-picker">
            <label for="blog-language-select" class="form-label">İçerik Dili</label>
            <select id="blog-language-select" class="form-select" x-model="selectedLanguage" x-on:change="$nextTick(() => window.dispatchEvent(new CustomEvent('admin:autosize')))">
                @for (var i = 0; i < Model.Translations.Count; i++)
                {
                    var code = Model.Translations[i].LanguageCode;
                    var label = code switch
                    {
                        "TR" => "Türkçe (TR) - Zorunlu",
                        "EN" => "English (EN)",
                        "DE" => "Deutsch (DE)",
                        "FR" => "Français (FR)",
                        "ES" => "Español (ES)",
                        "AR" => "العربية (AR)",
                        "RU" => "Русский (RU)",
                        _ => $"{Model.Translations[i].LanguageName} ({code})"
                    };
                    <option value="@code">@label</option>
                }
            </select>
            <div class="admin-form-language-helper" x-text="selectedLanguage === 'TR' ? 'Türkçe içerik zorunludur.' : 'Bu dil için çeviri alanlarını doldurabilirsiniz.'"></div>
        </div>

        <div>
            @for (var i = 0; i < Model.Translations.Count; i++)
            {
                var code = Model.Translations[i].LanguageCode;
                var dir = code == "AR" ? "rtl" : "ltr";
                <div class="admin-form-language-panel" x-show="selectedLanguage === '@code'" x-cloak x-bind:aria-hidden="selectedLanguage !== '@code'" dir="@dir">
                    <input type="hidden" name="Translations.Index" value="@i" />
                    <input type="hidden" asp-for="Translations[i].LanguageId" />
                    <input type="hidden" asp-for="Translations[i].LanguageCode" />
                    <input type="hidden" asp-for="Translations[i].LanguageName" />
                    <div class="admin-form-grid">
                        <div class="admin-form-field">
                            <label asp-for="Translations[i].Title" class="form-label"></label>
                            <input asp-for="Translations[i].Title" class="form-control" />
                            <span asp-validation-for="Translations[i].Title" class="text-danger"></span>
                        </div>
                        <div class="admin-form-field">
                            <label asp-for="Translations[i].SeoUrl" class="form-label"></label>
                            <input asp-for="Translations[i].SeoUrl" class="form-control" />
                            <span asp-validation-for="Translations[i].SeoUrl" class="text-danger"></span>
                        </div>
                        <div class="admin-form-field admin-form-field-full">
                            <label asp-for="Translations[i].Excerpt" class="form-label"></label>
                            <textarea asp-for="Translations[i].Excerpt" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Translations[i].Excerpt" class="text-danger"></span>
                        </div>
                        <div class="admin-form-field admin-form-field-full">
                            <label asp-for="Translations[i].Content" class="form-label"></label>
                            <textarea asp-for="Translations[i].Content" class="form-control" rows="6"></textarea>
                            <span asp-validation-for="Translations[i].Content" class="text-danger"></span>
                        </div>
                        <div class="admin-form-field">
                            <label asp-for="Translations[i].MetaTitle" class="form-label"></label>
                            <input asp-for="Translations[i].MetaTitle" class="form-control" />
                            <span asp-validation-for="Translations[i].MetaTitle" class="text-danger"></span>
                        </div>
                        <div class="admin-form-field">
                            <label asp-for="Translations[i].MetaDescription" class="form-label"></label>
                            <textarea asp-for="Translations[i].MetaDescription" class="form-control admin-form-autosize" rows="1" data-auto-resize></textarea>
                            <span asp-validation-for="Translations[i].MetaDescription" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<div class="admin-form-footer">
    <div class="admin-form-actions">
        <button type="submit" class="btn btn-primary admin-form-action-btn">
            <i class="ti ti-device-floppy" aria-hidden="true"></i>
            <span>Kaydet</span>
        </button>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
        <i class="ti ti-x" aria-hidden="true"></i>
        <span>Iptal</span>
    </a>
</div>
