@using Infrastructure.Identity
@model IReadOnlyList<Application.Pages.PageDto>
@{
    ViewData["Title"] = "Sayfa Yönetimi";
    var canCreate = User.IsInRole(ApplicationRoles.Admin) || User.IsInRole(ApplicationRoles.ContentEditor);
    var canEdit = canCreate || User.IsInRole(ApplicationRoles.SeoEditor);
    var canDelete = canCreate;
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="admin-list-page">
    <div class="admin-list-toolbar">
        <div class="d-flex align-items-start gap-2">
            <button type="button"
                    class="btn btn-outline-secondary btn-icon"
                    aria-label="Geri dön"
                    title="Geri dön"
                    onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '@Url.Action("Index", "Home")'; }">
                <i class="ti ti-arrow-left" aria-hidden="true"></i>
            </button>
            <div>
                <h1 class="admin-list-title">Sayfa Listesi</h1>
                <p class="admin-list-description">Kurumsal sayfaları, içerik bloklarını ve yayın durumlarını yönetin.</p>
            </div>
        </div>
        @if (canCreate)
        {
            <div class="admin-list-actions">
                <a asp-controller="Page" asp-action="Create" class="btn btn-primary admin-list-action-btn">
                    <i class="ti ti-plus" aria-hidden="true"></i>
                    <span>Yeni Sayfa</span>
                </a>
            </div>
        }
    </div>

    <section class="card admin-list-card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table admin-list-table">
                <thead>
                    <tr>
                        <th>Sayfa Başlığı</th>
                        <th>SEO URL</th>
                        <th>Güncellenme</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                @if (Model.Any())
                {
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-truncate-cell">@item.DisplayTitle</td>
                            <td class="text-truncate-cell">@item.Translations.FirstOrDefault(t => t.LanguageCode == "TR")?.SeoUrl</td>
                            <td>@item.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="admin-row-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-ghost-secondary" aria-label="@item.DisplayTitle sayfasını görüntüle">
                                        <i class="ti ti-eye" aria-hidden="true"></i>
                                        <span>Detay</span>
                                    </a>
                                    @if (canEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-ghost-secondary" aria-label="@item.DisplayTitle sayfasını düzenle">
                                            <i class="ti ti-pencil" aria-hidden="true"></i>
                                            <span>Düzenle</span>
                                        </a>
                                    }
                                    @if (canDelete)
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-ghost-danger" aria-label="@item.DisplayTitle sayfasını sil">
                                                <i class="ti ti-trash" aria-hidden="true"></i>
                                                <span>Sil</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                }
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="empty admin-list-empty-state">
                <div class="empty-icon">
                    <span class="avatar bg-primary-lt text-primary" aria-hidden="true"><i class="ti ti-file"></i></span>
                </div>
                <p class="empty-title">Henüz sayfa eklenmedi.</p>
                <p class="empty-subtitle text-secondary">Kurumsal içerikleri oluşturmak için ilk sayfayı ekleyin.</p>
                @if (canCreate)
                {
                    <div class="empty-action">
                        <a asp-action="Create" class="btn btn-primary admin-list-action-btn">
                            <i class="ti ti-plus" aria-hidden="true"></i>
                            <span>İlk Sayfayı Ekle</span>
                        </a>
                    </div>
                }
            </div>
        }
    </section>
</div>
