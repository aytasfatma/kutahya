@model Presentation.Models.Page.PageFormViewModel

<div asp-validation-summary="All" class="alert alert-danger"></div>

@if (!Model.CanEditContentFields || !Model.CanEditSeoFields)
{
    <div class="alert alert-info">Rolunuz yalnizca bu formun bir kismini duzenleyebilir; izinsiz alanlar salt okunurdur.</div>
}

@{
    var titleDisabled = Model.CanEditContentFields ? null : "disabled";
    var seoDisabled = Model.CanEditSeoFields ? null : "disabled";
    var suppressFooter = ViewData["SuppressPageFormFooter"] as bool? == true;
}

<section class="card admin-form-section" x-data="{ selectedLanguage: 'TR' }">
    <div class="card-header">
        <h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">1</span>Ceviriler ve SEO</h3>
    </div>
    <div class="card-body">
        <p class="admin-form-section-intro">Kullanmak istediğiniz içerik dilini seçerek ilgili alanları doldurun.</p>
        <div class="admin-form-language-picker">
            <label for="page-language-select" class="form-label">İçerik Dili</label>
            <select id="page-language-select" class="form-select" x-model="selectedLanguage" x-on:change="$nextTick(() => window.dispatchEvent(new CustomEvent('admin:autosize')))">
                @for (var i = 0; i < Model.Translations.Count; i++)
                {
                    var code = Model.Translations[i].LanguageCode;
                    var label = code switch
                    {
                        "TR" => "Türkçe (TR) - Zorunlu",
                        "EN" => "English (EN)",
                        "DE" => "Deutsch (DE)",
                        "FR" => "Français (FR)",
                        "ES" => "Español (ES)",
                        "AR" => "العربية (AR)",
                        "RU" => "Русский (RU)",
                        _ => $"{Model.Translations[i].LanguageName} ({code})"
                    };
                    <option value="@code">@label</option>
                }
            </select>
            <div class="admin-form-language-helper" x-text="selectedLanguage === 'TR' ? 'Türkçe içerik zorunludur.' : 'Bu dil için çeviri alanlarını doldurabilirsiniz.'"></div>
        </div>

        <div>
            @for (var i = 0; i < Model.Translations.Count; i++)
            {
                var code = Model.Translations[i].LanguageCode;
                var dir = code == "AR" ? "rtl" : "ltr";
                <div class="admin-form-language-panel" x-show="selectedLanguage === '@code'" x-cloak x-bind:aria-hidden="selectedLanguage !== '@code'" dir="@dir">
                    <input type="hidden" name="Translations.Index" value="@i" />
                    <input type="hidden" asp-for="Translations[i].LanguageId" />
                    <input type="hidden" asp-for="Translations[i].LanguageCode" />
                    <input type="hidden" asp-for="Translations[i].LanguageName" />
                    <div class="admin-form-grid">
                        <div class="admin-form-field">
                            <label asp-for="Translations[i].Title" class="form-label"></label>
                            <input asp-for="Translations[i].Title" class="form-control" disabled="@titleDisabled" />
                            <span asp-validation-for="Translations[i].Title" class="text-danger"></span>
                        </div>
                        <div class="admin-form-field">
                            <label asp-for="Translations[i].SeoUrl" class="form-label"></label>
                            <input asp-for="Translations[i].SeoUrl" class="form-control" disabled="@seoDisabled" />
                            <span asp-validation-for="Translations[i].SeoUrl" class="text-danger"></span>
                        </div>
                        <div class="admin-form-field">
                            <label asp-for="Translations[i].MetaTitle" class="form-label"></label>
                            <input asp-for="Translations[i].MetaTitle" class="form-control" disabled="@seoDisabled" />
                            <span asp-validation-for="Translations[i].MetaTitle" class="text-danger"></span>
                        </div>
                        <div class="admin-form-field">
                            <label asp-for="Translations[i].MetaDescription" class="form-label"></label>
                            <textarea asp-for="Translations[i].MetaDescription" class="form-control admin-form-autosize" rows="1" data-auto-resize disabled="@seoDisabled"></textarea>
                            <span asp-validation-for="Translations[i].MetaDescription" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@if (!suppressFooter)
{
    <div class="admin-form-footer">
        <div class="admin-form-actions">
            <button type="submit" class="btn btn-primary admin-form-action-btn">
                <i class="ti ti-device-floppy" aria-hidden="true"></i>
                <span>Kaydet</span>
            </button>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
            <i class="ti ti-x" aria-hidden="true"></i>
            <span>İptal</span>
        </a>
    </div>
}
