@model Presentation.Models.Document.DocumentFormViewModel
<div asp-validation-summary="All" class="alert alert-danger"></div>
<section class="card admin-form-section"><div class="card-header"><h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">1</span>Doküman Bilgileri</h3></div><div class="card-body"><div class="admin-form-grid">
<div class="admin-form-field"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" placeholder="Doküman adı" /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="admin-form-field admin-form-field-full"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="2" placeholder="Dokümanın kısa açıklaması"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="admin-form-field"><label asp-for="DocumentType" class="form-label"></label><select asp-for="DocumentType" asp-items="Model.DocumentTypeOptions" class="form-select"><option value="">Doküman tipi seçin</option></select><span asp-validation-for="DocumentType" class="text-danger"></span></div>
<div class="admin-form-field"><label asp-for="Brand" class="form-label"></label><select asp-for="Brand" asp-items="Model.BrandOptions" class="form-select" id="documentBrand"><option value="">Marka seçin</option></select><span asp-validation-for="Brand" class="text-danger"></span></div>
<div class="admin-form-field"><label asp-for="SelectedCollectionId" class="form-label"></label><select asp-for="SelectedCollectionId" asp-items="Model.CollectionOptions" class="form-select" id="documentCollection"><option value="">Koleksiyon seçin</option></select><span asp-validation-for="SelectedCollectionId" class="text-danger"></span></div>
<input asp-for="LanguageId" type="hidden" /><input asp-for="DisplayOrder" type="hidden" />
</div></div></section>
<section class="card admin-form-section"><div class="card-header"><h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">2</span>Dosya</h3></div><div class="card-body"><div class="admin-form-upload">
@if (Model.Id.HasValue) { <div class="mb-3"><div class="text-secondary small">Mevcut dosya</div><a href="@Model.ExistingFilePath" target="_blank" rel="noopener">@Model.ExistingOriginalFileName</a> <span class="text-secondary">(@Model.ExistingFileSizeLabel)</span></div><label for="file" class="form-label">Dosyayı Değiştir (opsiyonel)</label><input type="file" id="file" name="file" accept=".pdf" class="form-control" /> }
else { <label for="file" class="form-label">PDF Dosyası</label><input type="file" id="file" name="file" accept=".pdf" class="form-control" required /> }
<div class="admin-form-help">İzin verilen format: PDF. Maksimum dosya boyutu: 20 MB.</div></div></div></section>
<div class="admin-form-footer"><div class="admin-form-actions"><button type="submit" class="btn btn-primary admin-form-action-btn"><i class="ti ti-upload" aria-hidden="true"></i><span>Yükle</span></button></div><a asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn"><i class="ti ti-x" aria-hidden="true"></i><span>İptal</span></a></div>
<script>(()=>{const brand=document.getElementById('documentBrand'),collection=document.getElementById('documentCollection');if(!brand||!collection)return;const initial=collection.value;const load=async()=>{const response=await fetch(`/api/public/collections?lang=tr${brand.value?`&brand=${encodeURIComponent(brand.value)}`:''}`),items=response.ok?await response.json():[],selected=collection.value||initial;collection.replaceChildren(new Option('Koleksiyon seçin',''));items.forEach(item=>collection.add(new Option(item.name,item.id,false,String(item.id)===selected)));};brand.addEventListener('change',()=>{collection.value='';load();});if(brand.value)load();})();</script>
