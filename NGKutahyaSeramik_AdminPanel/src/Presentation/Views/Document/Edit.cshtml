@model Presentation.Models.Document.DocumentFormViewModel

@{
    ViewData["Title"] = "Doküman Düzenle";
    ViewData["UseDocumentRelationPicker"] = true;
}

<div class="admin-form-page">
    <div class="admin-form-header">
        <div>
            <p class="admin-form-description">Doküman bilgilerini, dosyasını ve ilişkilendirme ayarlarını güncelleyiniz.</p>
        </div>
        <a asp-controller="Document" asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
            <span>Doküman Yönetimi'ne Dön</span>
        </a>
    </div>

    <form asp-controller="Document" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="admin-form-shell">
        @await Html.PartialAsync("_DocumentForm", Model)
    </form>
</div>
