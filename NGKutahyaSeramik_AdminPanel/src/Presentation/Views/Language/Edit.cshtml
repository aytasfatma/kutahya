@model Presentation.Models.Language.LanguageEditViewModel
@{
    ViewData["Title"] = "Dil Düzenle";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-link ps-0"><i class="ti ti-arrow-left me-1"></i>Listeye Dön</a>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Dil Düzenle</h3>
    </div>
    <div class="card-body">
        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <form asp-controller="Language" asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@Html.DisplayNameFor(m => m.Code)</label>
                    <input type="text" class="form-control" value="@Model.Code" disabled />
                    <input type="hidden" asp-for="Code" />
                    <small class="form-hint">Dil kodu salt okunurdur, değiştirilemez.</small>
                </div>
                <div class="col-md-4">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DisplayOrder" class="form-label"></label>
                    <input asp-for="DisplayOrder" type="number" min="1" step="1" class="form-control" />
                    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                </div>
                <div class="col-12">
                    @if (Model.IsTurkish)
                    {
                        <label class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" checked disabled />
                            <input type="hidden" name="IsActive" value="true" />
                            <span class="form-check-label">@Html.DisplayNameFor(m => m.IsActive)</span>
                        </label>
                        <div class="form-hint">Türkçe (TR) varsayılan dil olduğu için devre dışı bırakılamaz.</div>
                    }
                    else
                    {
                        <label class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <span class="form-check-label">@Html.DisplayNameFor(m => m.IsActive)</span>
                        </label>
                    }
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Kaydet</button>
            </div>
        </form>
    </div>
</div>

