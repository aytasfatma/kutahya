@using Infrastructure.Identity
@model IReadOnlyList<Application.Surfaces.SurfaceListItemDto>
@{
    ViewData["Title"] = "Yüzey Yönetimi";
    var canEdit = User.IsInRole(ApplicationRoles.Admin) || User.IsInRole(ApplicationRoles.ProductManager);
    var canDelete = User.IsInRole(ApplicationRoles.Admin);
    var orderedSurfaces = Model.OrderBy(x => x.Name, StringComparer.Create(new System.Globalization.CultureInfo("tr-TR"), true)).ToList();
}

@if (TempData["SuccessMessage"] is not null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] is not null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

<div class="admin-list-page">
    <div class="admin-list-toolbar">
        <div class="d-flex align-items-start gap-2">
            <button type="button" class="btn btn-outline-secondary btn-icon" aria-label="Geri dön" title="Geri dön"
                    onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '@Url.Action("Index", "Home")'; }">
                <i class="ti ti-arrow-left" aria-hidden="true"></i>
            </button>
            <div>
                <h1 class="admin-list-title">Yüzeyler</h1>
                <p class="admin-list-description">Excel yüzey kolonundan gelen ürün yüzeylerini yönetin.</p>
            </div>
        </div>
        <div class="admin-list-actions">
            @if (canEdit) { <a asp-action="Create" class="btn btn-primary admin-list-action-btn"><i class="ti ti-plus"></i><span>Yeni Yüzey Ekle</span></a> }
        </div>
    </div>

    <section class="card admin-list-card" aria-labelledby="surface-list-title">
        <div class="table-responsive">
            <table class="table table-vcenter card-table admin-list-table">
                <thead><tr><th>ID</th><th>Yüzey Adı</th><th>Ürün Sayısı</th><th>Durum</th><th class="text-end">İşlemler</th></tr></thead>
                @if (Model.Any())
                {
                    <tbody>
                    @foreach (var item in orderedSurfaces)
                    {
                        <tr>
                            <td class="text-secondary">#@item.Id</td>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.ProductCount</td>
                            <td><span class="badge admin-status-badge @(item.IsActive ? "bg-success-lt" : "bg-secondary-lt")">@(item.IsActive ? "Aktif" : "Pasif")</span></td>
                            <td class="text-end"><div class="admin-row-actions">
                                @if (canEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-ghost-secondary"><i class="ti ti-pencil"></i><span>Düzenle</span></a>
                                    <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post"><button type="submit" class="btn btn-sm btn-ghost-secondary">@(item.IsActive ? "Pasif Yap" : "Aktif Yap")</button></form>
                                }
                                @if (canDelete)
                                {
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Yüzey silinsin mi?')"><button type="submit" class="btn btn-sm btn-ghost-danger"><i class="ti ti-trash"></i><span>Sil</span></button></form>
                                }
                            </div></td>
                        </tr>
                    }
                    </tbody>
                }
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="empty admin-list-empty-state"><div class="empty-icon"><span class="avatar bg-primary-lt text-primary"><i class="ti ti-texture"></i></span></div><p class="empty-title">Henüz yüzey eklenmedi.</p><p class="empty-subtitle text-secondary">Ürünlerde kullanılacak ilk yüzeyi ekleyin.</p>@if (canEdit) { <div class="empty-action"><a asp-action="Create" class="btn btn-primary admin-list-action-btn"><i class="ti ti-plus"></i><span>İlk Yüzeyi Ekle</span></a></div> }</div>
        }
    </section>
</div>
