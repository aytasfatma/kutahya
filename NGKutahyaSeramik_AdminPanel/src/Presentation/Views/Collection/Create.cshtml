@model Presentation.Models.Collection.CollectionFormViewModel
@{
    ViewData["Title"] = "Yeni Koleksiyon";
}

<div class="admin-form-page">
    <div class="admin-form-header">
        <p class="admin-form-description">Yeni koleksiyon oluşturmak için gerekli bilgileri giriniz.</p>
        <a asp-controller="Collection" asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
            <span>Koleksiyon Yönetimi'ne Dön</span>
        </a>
    </div>
    <form asp-controller="Collection" asp-action="Create" method="post" class="admin-form-shell">
        @await Html.PartialAsync("_CollectionForm", Model)
    </form>
</div>
