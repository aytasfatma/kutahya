@using Infrastructure.Identity
@model IReadOnlyList<Application.Collections.CollectionDto>
@{
    ViewData["Title"] = "Koleksiyon Yönetimi";
    var canEdit = User.IsInRole(ApplicationRoles.Admin) || User.IsInRole(ApplicationRoles.ProductManager);
    var canDelete = User.IsInRole(ApplicationRoles.Admin);
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="admin-list-page">
    <div class="admin-list-toolbar">
        <div class="d-flex align-items-start gap-2">
            <button type="button"
                    class="btn btn-outline-secondary btn-icon"
                    aria-label="Geri dön"
                    title="Geri dön"
                    onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '@Url.Action("Index", "Home")'; }">
                <i class="ti ti-arrow-left" aria-hidden="true"></i>
            </button>
            <div>
                <h1 class="admin-list-title">Koleksiyon Listesi</h1>
                <p class="admin-list-description">Ürün koleksiyonlarını, marka bağlantılarını ve yayın durumlarını yönetin.</p>
            </div>
        </div>
        <div class="admin-list-actions">
            @if (canEdit)
            {
                <a asp-controller="Collection" asp-action="Create" class="btn btn-primary admin-list-action-btn">
                    <i class="ti ti-plus" aria-hidden="true"></i>
                    <span>Yeni Koleksiyon Ekle</span>
                </a>
            }
        </div>
    </div>

    <section class="card admin-list-card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table admin-list-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Koleksiyon Adı</th>
                        <th>Ürün Sayısı</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                @if (Model.Any())
                {
                    <tbody>
                    @foreach (var collection in Model.OrderBy(c => c.DisplayName, StringComparer.Create(new System.Globalization.CultureInfo("tr-TR"), true)))
                    {
                        <tr>
                            <td class="text-secondary">#@collection.Id</td>
                            <td class="fw-semibold">@collection.DisplayName</td>
                            <td>@collection.ProductCount</td>
                            <td>
                                <span class="badge admin-status-badge @(collection.IsActive ? "bg-success-lt" : "bg-secondary-lt")">
                                    @(collection.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="admin-row-actions">
                                    @if (canEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@collection.Id" class="btn btn-sm btn-ghost-secondary" aria-label="@collection.DisplayName koleksiyonunu düzenle">
                                            <i class="ti ti-pencil" aria-hidden="true"></i>
                                            <span>Düzenle</span>
                                        </a>
                                        <form asp-action="ToggleActive" asp-route-id="@collection.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-ghost-secondary" aria-label="@collection.DisplayName durumunu değiştir">
                                                @(collection.IsActive ? "Pasif Yap" : "Aktif Yap")
                                            </button>
                                        </form>
                                    }
                                    @if (canDelete)
                                    {
                                        <form asp-action="Delete" asp-route-id="@collection.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-ghost-danger" aria-label="@collection.DisplayName koleksiyonunu sil">
                                                <i class="ti ti-trash" aria-hidden="true"></i>
                                                <span>Sil</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                }
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="empty admin-list-empty-state">
                <div class="empty-icon">
                    <span class="avatar bg-primary-lt text-primary" aria-hidden="true"><i class="ti ti-stack-2"></i></span>
                </div>
                <p class="empty-title">Henüz koleksiyon eklenmedi.</p>
                <p class="empty-subtitle text-secondary">Ürünlerinizi seri ve koleksiyon bazında gruplandırmaya başlayın.</p>
                @if (canEdit)
                {
                    <div class="empty-action">
                        <a asp-action="Create" class="btn btn-primary admin-list-action-btn">
                            <i class="ti ti-plus" aria-hidden="true"></i>
                            <span>İlk Koleksiyonu Ekle</span>
                        </a>
                    </div>
                }
            </div>
        }
    </section>
</div>
