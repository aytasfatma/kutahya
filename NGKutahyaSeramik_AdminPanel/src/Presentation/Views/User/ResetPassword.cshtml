@model Presentation.Models.User.ResetPasswordViewModel
@{
    ViewData["Title"] = "Parola Sıfırla";
}

<div class="admin-form-page">
    <p class="admin-form-description">@Model.Email kullanıcısı için yeni parola belirleyin.</p>

    <form asp-controller="User" asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" class="admin-form-shell">
        <div asp-validation-summary="All" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Email" />

        <section class="card admin-form-section">
            <div class="card-header">
                <h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">1</span>Parola Bilgileri</h3>
            </div>
            <div class="card-body">
                <div class="admin-form-grid">
                    <div class="admin-form-field">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" type="password" autocomplete="new-password" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="admin-form-field">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="admin-form-footer">
            <div class="admin-form-actions">
                <button type="submit" class="btn btn-primary admin-form-action-btn">
                    <i class="ti ti-key" aria-hidden="true"></i>
                    <span>Parolayı Sıfırla</span>
                </button>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
                <i class="ti ti-x" aria-hidden="true"></i>
                <span>İptal</span>
            </a>
        </div>
    </form>
</div>
