@model Presentation.Models.User.UserFormViewModel
@{
    ViewData["Title"] = "Yeni Kullanıcı";
}

<div class="admin-form-page">
    <div class="admin-form-header">
        <p class="admin-form-description">Yönetim paneli kullanıcısının hesap ve rol bilgilerini giriniz.</p>
        <a asp-controller="User" asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
            <span>Kullanıcı Yönetimi'ne Dön</span>
        </a>
    </div>
    <form asp-controller="User" asp-action="Create" method="post" class="admin-form-shell">
        @await Html.PartialAsync("_UserForm", Model)
    </form>
</div>
