@model Presentation.Models.User.UserFormViewModel

<div asp-validation-summary="All" class="alert alert-danger"></div>

<section class="card admin-form-section">
    <div class="card-header">
        <h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">1</span>Hesap Bilgileri</h3>
    </div>
    <div class="card-body">
        <div class="admin-form-grid">
            @if (Model.Id is null)
            {
                <div class="admin-form-field">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" placeholder="kullanici@ornek.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            }
            else
            {
                <div class="admin-form-field">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="form-control-plaintext">@Model.Email</div>
                </div>
            }
        </div>
    </div>
</section>

@if (Model.Id is null)
{
    <section class="card admin-form-section">
        <div class="card-header">
            <h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">2</span>Güvenlik</h3>
        </div>
        <div class="card-body">
            <div class="admin-form-grid">
                <div class="admin-form-field">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" placeholder="Geçici parola" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <div class="admin-form-help">Mevcut parola politikası sunucu tarafında doğrulanır.</div>
                </div>
                <div class="admin-form-field">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" placeholder="Parolayı tekrar girin" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
        </div>
    </section>
}

<section class="card admin-form-section">
    <div class="card-header">
        <h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">3</span>Rol ve Durum</h3>
    </div>
    <div class="card-body">
        <div class="admin-form-grid">
            <div class="admin-form-field">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role" selected="@(Model.Role == role ? "selected" : null)">@role</option>
                    }
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
            <div class="admin-form-field">
                <label asp-for="IsActive" class="form-label"></label>
                <label class="form-check form-switch mt-2">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <span class="form-check-label">Kullanıcı aktif</span>
                </label>
            </div>
        </div>
    </div>
</section>

<div class="admin-form-footer">
    <div class="admin-form-actions">
        <button type="submit" class="btn btn-primary admin-form-action-btn">
            <i class="ti ti-user-plus" aria-hidden="true"></i>
            <span>@(Model.Id is null ? "Kullanıcı Oluştur" : "Kaydet")</span>
        </button>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
        <i class="ti ti-x" aria-hidden="true"></i>
        <span>İptal</span>
    </a>
</div>
