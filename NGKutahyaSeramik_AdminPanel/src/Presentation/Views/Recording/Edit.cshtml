@model Presentation.Models.Recording.RecordingFormViewModel
@{ ViewData["Title"] = "Kayıt Düzenle"; }
<div class="admin-form-page">
    <div class="admin-form-header"><div><h1 class="admin-list-title">Kayıt Düzenle</h1><p class="admin-form-description">Video ve açıklama bilgilerini güncelleyin.</p></div><a asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left"></i> Kayıt Yönetimi'ne Dön</a></div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form-shell"><input asp-for="Id" type="hidden" />@await Html.PartialAsync("_RecordingForm", Model)</form>
</div>
