@model Presentation.Models.ReferenceProject.ReferenceProjectFormViewModel

<div asp-validation-summary="All" class="alert alert-danger"></div>

<section class="card admin-form-section">
    <div class="card-header">
        <h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">1</span>Temel Bilgiler</h3>
    </div>
    <div class="card-body">
        <div class="admin-form-grid">
            <div class="admin-form-field">
                <label asp-for="Region" class="form-label"></label>
                <select asp-for="Region" asp-items="Model.RegionOptions" class="form-select">
                    <option value="">Bölge seçin</option>
                </select>
                <span asp-validation-for="Region" class="text-danger"></span>
            </div>
            <div class="admin-form-field">
                <label asp-for="Brand" class="form-label"></label>
                <select asp-for="Brand" asp-items="Model.BrandOptions" class="form-select">
                    <option value="">Marka seçin</option>
                </select>
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>
            <div class="admin-form-field">
                <label asp-for="ProjectType" class="form-label"></label>
                <select asp-for="ProjectType" asp-items="Model.ProjectTypeOptions" class="form-select"></select>
                <span asp-validation-for="ProjectType" class="text-danger"></span>
            </div>
            <div class="admin-form-field">
                <label asp-for="ProjectDate" class="form-label"></label>
                <input asp-for="ProjectDate" type="date" min="1900-01-01" max="2030-12-31" class="form-control" />
                <span asp-validation-for="ProjectDate" class="text-danger"></span>
            </div>
            <div class="admin-form-field">
                <label asp-for="Architect" class="form-label"></label>
                <input asp-for="Architect" class="form-control" placeholder="Mimar / ofis" />
                <span asp-validation-for="Architect" class="text-danger"></span>
            </div>
            <div class="admin-form-field">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" type="number" min="1" step="1" class="form-control" />
                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
            </div>
        </div>
    </div>
</section>

<section class="card admin-form-section">
    <div class="card-header">
        <h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">2</span>Lokasyon ve İlişkili Ürünler</h3>
    </div>
    <div class="card-body">
        <div class="admin-form-grid">
            <div class="admin-form-field">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" placeholder="Şehir / ülke" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
            @await Html.PartialAsync("_ReferenceProjectProductPicker", Model)
        </div>
    </div>
</section>

<section class="card admin-form-section" x-data="{ selectedLanguage: 'TR' }">
    <div class="card-header">
        <h3 class="admin-form-section-title"><span class="avatar bg-primary-lt text-primary">3</span>Çeviriler</h3>
    </div>
    <div class="card-body">
        <p class="admin-form-section-intro">Kullanmak istediğiniz içerik dilini seçerek ilgili alanları doldurun.</p>
        <div class="admin-form-language-picker">
            <label for="reference-language-select" class="form-label">İçerik Dili</label>
            <select id="reference-language-select" class="form-select" x-model="selectedLanguage" x-on:change="$nextTick(() => window.dispatchEvent(new CustomEvent('admin:autosize')))">
                @for (var i = 0; i < Model.Translations.Count; i++)
                {
                    var code = Model.Translations[i].LanguageCode;
                    var label = code switch
                    {
                        "TR" => "Türkçe (TR) - Zorunlu",
                        "EN" => "English (EN)",
                        "DE" => "Deutsch (DE)",
                        "FR" => "Français (FR)",
                        "ES" => "Español (ES)",
                        "AR" => "العربية (AR)",
                        "RU" => "Русский (RU)",
                        _ => $"{Model.Translations[i].LanguageName} ({code})"
                    };
                    <option value="@code">@label</option>
                }
            </select>
            <div class="admin-form-language-helper" x-text="selectedLanguage === 'TR' ? 'Türkçe içerik zorunludur.' : 'Bu dil için çeviri alanlarını doldurabilirsiniz.'"></div>
        </div>

        <div>
            @for (var i = 0; i < Model.Translations.Count; i++)
            {
                var code = Model.Translations[i].LanguageCode;
                var dir = code == "AR" ? "rtl" : "ltr";
                <div class="admin-form-language-panel" x-show="selectedLanguage === '@code'" x-cloak x-bind:aria-hidden="selectedLanguage !== '@code'" dir="@dir">
                    <input type="hidden" name="Translations.Index" value="@i" />
                    <input type="hidden" asp-for="Translations[i].LanguageId" />
                    <input type="hidden" asp-for="Translations[i].LanguageCode" />
                    <input type="hidden" asp-for="Translations[i].LanguageName" />
                    <div class="admin-form-grid">
                        <div class="admin-form-field">
                            <label asp-for="Translations[i].ProjectName" class="form-label"></label>
                            <input asp-for="Translations[i].ProjectName" class="form-control" />
                            <span asp-validation-for="Translations[i].ProjectName" class="text-danger"></span>
                        </div>
                        <div class="admin-form-field">
                            <label asp-for="Translations[i].SeoUrl" class="form-label"></label>
                            <input asp-for="Translations[i].SeoUrl" class="form-control" />
                            <span asp-validation-for="Translations[i].SeoUrl" class="text-danger"></span>
                        </div>
                        <div class="admin-form-field admin-form-field-full">
                            <label asp-for="Translations[i].Description" class="form-label"></label>
                            <textarea asp-for="Translations[i].Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Translations[i].Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@if (ViewData["SuppressReferenceProjectFormFooter"] is not true)
{
    <div class="admin-form-footer">
        <div class="admin-form-actions">
            <button type="submit" class="btn btn-primary admin-form-action-btn">
                <i class="ti ti-device-floppy" aria-hidden="true"></i>
                <span>Kaydet</span>
            </button>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
            <i class="ti ti-x" aria-hidden="true"></i>
            <span>İptal</span>
        </a>
    </div>
}
