@model Presentation.Models.ReferenceProject.ReferenceProjectFormViewModel
@{
    ViewData["Title"] = "Yeni Referans Proje";
}

<div class="admin-form-page">
    <div class="admin-form-header">
        <div>
            <p class="admin-form-description">Referans proje bilgilerini, görsellerini ve ilişkili ürünleri giriniz.</p>
        </div>
        <a asp-controller="ReferenceProject" asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
            <span>Referans Projelere Dön</span>
        </a>
    </div>
    <form asp-controller="ReferenceProject" asp-action="Create" method="post" class="admin-form-shell">
        @await Html.PartialAsync("_ReferenceProjectForm", Model)
    </form>
</div>
