@using System.Text.Json
@using Infrastructure.Identity
@model IReadOnlyList<Application.ReferenceProjects.ReferenceProjectDto>
@{
    ViewData["Title"] = "Referans Projeler";
    var canEdit = User.IsInRole(ApplicationRoles.Admin) || User.IsInRole(ApplicationRoles.ContentEditor);
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="admin-list-page">
    <div class="admin-list-toolbar">
        <div class="d-flex align-items-start gap-2">
            <button type="button"
                    class="btn btn-outline-secondary btn-icon"
                    aria-label="Geri dön"
                    title="Geri dön"
                    onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '@Url.Action("Index", "Home")'; }">
                <i class="ti ti-arrow-left" aria-hidden="true"></i>
            </button>
            <div>
                <h1 class="admin-list-title">Referans Proje Listesi</h1>
                <p class="admin-list-description">Tamamlanan projeleri, görselleri ve ilişkili ürünleri yönetin.</p>
            </div>
        </div>
        @if (canEdit)
        {
            <div class="admin-list-actions">
                <a asp-action="Create" class="btn btn-primary admin-list-action-btn">
                    <i class="ti ti-plus" aria-hidden="true"></i>
                    <span>Yeni Referans Proje Ekle</span>
                </a>
            </div>
        }
    </div>

    <section class="card admin-list-card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table admin-list-table">
                <thead>
                    <tr>
                        <th>Kapak</th>
                        <th>Proje Adı</th>
                        <th>Proje Türü</th>
                        <th>Lokasyon</th>
                        <th>Yıl</th>
                        <th>İlişkili Ürünler</th>
                        <th>Durum</th>
                        <th>Sıra</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                @if (Model.Any())
                {
                    <tbody>
                    @foreach (var referenceProject in Model.OrderBy(rp => rp.DisplayOrder).ThenBy(rp => rp.DisplayName))
                    {
                        var title = referenceProject.DisplayName ?? $"Referans Proje #{referenceProject.Id}";
                        var productItems = referenceProject.RelatedProducts
                            .Select(product => new
                            {
                                id = product.Id,
                                label = product.Label,
                                href = Url.Action("Edit", "Product", new { id = product.Id })
                            })
                            .ToList();

                        <tr>
                            <td class="w-1">
                                @if (!string.IsNullOrWhiteSpace(referenceProject.FeaturedImagePath))
                                {
                                    <button type="button"
                                            class="product-preview-trigger"
                                            data-preview-src="@referenceProject.FeaturedImagePath"
                                            data-preview-title="@title"
                                            data-preview-code=""
                                            aria-label="@title kapak görselini büyüt">
                                        <img src="@referenceProject.FeaturedImagePath" alt="@title" class="product-preview-thumb" />
                                    </button>
                                }
                                else
                                {
                                    <span class="avatar avatar-sm bg-secondary-lt text-secondary" aria-hidden="true"><i class="ti ti-photo-off"></i></span>
                                }
                            </td>
                            <td class="fw-semibold">@referenceProject.DisplayName</td>
                            <td>@referenceProject.ProjectTypeLabel</td>
                            <td>@referenceProject.Location</td>
                            <td>@referenceProject.Year</td>
                            <td>
                                @if (productItems.Count == 0)
                                {
                                    <span class="text-secondary">-</span>
                                }
                                else if (productItems.Count <= 2)
                                {
                                    <div class="document-relation-inline-list">
                                        @foreach (var product in productItems)
                                        {
                                            <a href="@product.href" class="document-relation-inline-link">@product.label</a>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary document-relation-summary-btn"
                                            data-document-relation-title="@title"
                                            data-document-relation-kind="İlişkili Ürünler"
                                            data-document-relation-items='@JsonSerializer.Serialize(productItems)'
                                            aria-label="@title projesinin ilişkili ürünlerini göster">
                                        <i class="ti ti-box" aria-hidden="true"></i>
                                        <span>@productItems.Count ilişkili ürün</span>
                                    </button>
                                }
                            </td>
                            <td>
                                <span class="badge admin-status-badge @(referenceProject.IsActive ? "bg-success-lt" : "bg-secondary-lt")">
                                    @(referenceProject.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td>@referenceProject.DisplayOrder</td>
                            <td class="text-end">
                                @if (canEdit)
                                {
                                    <div class="admin-row-actions">
                                        <a asp-action="Edit" asp-route-id="@referenceProject.Id" class="btn btn-sm btn-ghost-secondary" aria-label="@referenceProject.DisplayName projesini düzenle">
                                            <i class="ti ti-pencil" aria-hidden="true"></i>
                                            <span>Düzenle</span>
                                        </a>
                                        <form asp-action="ToggleActive" asp-route-id="@referenceProject.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-ghost-secondary" aria-label="@referenceProject.DisplayName durumunu değiştir">
                                                @(referenceProject.IsActive ? "Pasif Yap" : "Aktif Yap")
                                            </button>
                                        </form>
                                        <form asp-action="Delete" asp-route-id="@referenceProject.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-ghost-danger" aria-label="@referenceProject.DisplayName projesini sil">
                                                <i class="ti ti-trash" aria-hidden="true"></i>
                                                <span>Sil</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                }
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="empty admin-list-empty-state">
                <div class="empty-icon">
                    <span class="avatar bg-primary-lt text-primary" aria-hidden="true"><i class="ti ti-folder"></i></span>
                </div>
                <p class="empty-title">Henüz referans proje eklenmedi.</p>
                <p class="empty-subtitle text-secondary">Markanın uygulama örneklerini sergilemek için ilk projeyi ekleyin.</p>
                @if (canEdit)
                {
                    <div class="empty-action">
                        <a asp-action="Create" class="btn btn-primary admin-list-action-btn">
                            <i class="ti ti-plus" aria-hidden="true"></i>
                            <span>İlk Referans Projeyi Ekle</span>
                        </a>
                    </div>
                }
            </div>
        }
    </section>

    <div class="modal fade product-preview-modal" id="referenceProjectImagePreviewModal" tabindex="-1" aria-labelledby="referenceProjectImagePreviewModalTitle" aria-hidden="true" data-product-preview-modal>
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-grid">
                        <h2 class="modal-title mb-0" id="referenceProjectImagePreviewModalTitle" data-product-preview-title>Referans Proje Görseli</h2>
                        <span class="text-secondary small" data-product-preview-code></span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="product-preview-stage">
                        <img src="" alt="" class="product-preview-image" data-product-preview-image />
                        <div class="product-preview-error d-none" role="status" data-product-preview-error>
                            <i class="ti ti-photo-x" aria-hidden="true"></i>
                            <span>Görsel yüklenemedi.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade document-relation-modal" id="referenceProjectRelationModal" tabindex="-1" aria-labelledby="referenceProjectRelationModalTitle" aria-hidden="true" data-document-relation-modal>
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-grid">
                        <h2 class="modal-title mb-0" id="referenceProjectRelationModalTitle" data-document-relation-modal-title>İlişkili Ürünler</h2>
                        <span class="text-secondary small" data-document-relation-modal-subtitle></span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="document-relation-modal-list" data-document-relation-modal-list></div>
                </div>
            </div>
        </div>
    </div>
</div>
