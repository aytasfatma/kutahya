@model Presentation.Models.Category.CategoryFormViewModel
@{
    ViewData["Title"] = "Kategoriyi Düzenle";
}

<div class="admin-form-page">
    <div class="admin-form-header">
        <p class="admin-form-description">Kategori bilgilerini ve yayın ayarlarını güncelleyiniz.</p>
        <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
            <span>Kategori Yönetimi'ne Dön</span>
        </a>
    </div>

    <form asp-controller="Category" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form-shell">
        @await Html.PartialAsync("_CategoryForm", Model)
    </form>
</div>
