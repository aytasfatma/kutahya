@model Presentation.Models.Product.ProductFormViewModel
@{
    ViewData["Title"] = "Yeni Urun";
}

<div class="admin-form-page">
    <div class="admin-form-header">
        <p class="admin-form-description">Urun bilgilerini, teknik ozellikleri, gorselleri ve icerik alanlarini giriniz.</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
            <span>Urun Yonetimi'ne Don</span>
        </a>
    </div>
    <form asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data" class="admin-form-shell" data-submit-lock>
        @await Html.PartialAsync("_ProductForm", Model)
        @await Html.PartialAsync("_ProductImageSection", Model)
        <div class="admin-form-footer">
            <div class="admin-form-actions">
                <button type="submit" class="btn btn-primary admin-form-action-btn" data-submit-lock-button>
                    <i class="ti ti-device-floppy" aria-hidden="true"></i>
                    <span data-submit-lock-label>Urunu Kaydet</span>
                </button>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
                <i class="ti ti-x" aria-hidden="true"></i>
                <span>Iptal</span>
            </a>
        </div>
    </form>
</div>
