@model Presentation.Models.News.NewsFormViewModel
@{
    ViewData["Title"] = "Yeni Bülten";
}

<div class="admin-form-page newsletter-page">
    <div class="admin-form-header">
        <div>
            <h1 class="admin-list-title">Yeni Bülten Hazırla</h1>
            <p class="admin-form-description">Bülten içeriğini oluşturun, yayın planını ve görselini belirleyin.</p>
        </div>
        <a asp-controller="News" asp-action="Index" class="btn btn-outline-secondary admin-form-action-btn">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
            <span>Bülten Yönetimi'ne Dön</span>
        </a>
    </div>
    <form asp-controller="News" asp-action="Create" method="post" enctype="multipart/form-data" class="admin-form-shell">
        @await Html.PartialAsync("_NewsForm", Model)
    </form>
</div>
