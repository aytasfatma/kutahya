@model IReadOnlyList<Application.Dealers.DealerImageDto>
@{
    var dealer = (Application.Dealers.DealerDto)ViewBag.Dealer;
    ViewData["Title"] = $"{dealer.Name} Görselleri";
}

<div class="admin-list-page">
    <div class="admin-list-toolbar">
        <div class="d-flex align-items-start gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-icon"><i class="ti ti-arrow-left"></i></a>
            <div><h1 class="admin-list-title">@dealer.Name Görselleri</h1><p class="admin-list-description">Kapak görselini ve web detay galerisindeki sıralamayı yönetin.</p></div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is not null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] is not null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

    <section class="card mb-4">
        <div class="card-body">
            <form asp-controller="DealerImage" asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
                <input type="hidden" name="dealerId" value="@dealer.Id" />
                <div class="col-md-8"><label class="form-label" for="dealerImage">Yeni Görsel</label><input id="dealerImage" name="file" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" required /><small class="form-hint">JPG, PNG veya WEBP; en fazla 5 MB.</small></div>
                <div class="col-md-4"><button type="submit" class="btn btn-primary w-100"><i class="ti ti-upload"></i> Görsel Yükle</button></div>
            </form>
        </div>
    </section>

    <section class="card">
        @if (Model.Count > 0)
        {
            <div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Önizleme</th><th>Durum</th><th>Sıra</th><th class="text-end">İşlemler</th></tr></thead><tbody>
            @for (var i = 0; i < Model.Count; i++)
            {
                var image = Model[i];
                <tr><td><img src="@image.FilePath" alt="@dealer.Name görseli" style="width:120px;height:80px;object-fit:cover;border-radius:8px" /></td><td>@if (image.IsFeatured) { <span class="badge bg-primary-lt">Kapak Görseli</span> } else { <span class="text-secondary">Galeri</span> }</td><td>@(i + 1)</td><td class="text-end"><div class="admin-row-actions">
                    @if (!image.IsFeatured) { <form asp-controller="DealerImage" asp-action="SetFeatured" method="post"><input type="hidden" name="dealerId" value="@dealer.Id"/><input type="hidden" name="imageId" value="@image.Id"/><button class="btn btn-sm btn-ghost-secondary">Kapak Yap</button></form> }
                    <form asp-controller="DealerImage" asp-action="MoveUp" method="post"><input type="hidden" name="dealerId" value="@dealer.Id"/><input type="hidden" name="imageId" value="@image.Id"/><button class="btn btn-sm btn-ghost-secondary" disabled="@(i == 0)">↑</button></form>
                    <form asp-controller="DealerImage" asp-action="MoveDown" method="post"><input type="hidden" name="dealerId" value="@dealer.Id"/><input type="hidden" name="imageId" value="@image.Id"/><button class="btn btn-sm btn-ghost-secondary" disabled="@(i == Model.Count - 1)">↓</button></form>
                    <form asp-controller="DealerImage" asp-action="Delete" method="post"><input type="hidden" name="dealerId" value="@dealer.Id"/><input type="hidden" name="imageId" value="@image.Id"/><button class="btn btn-sm btn-ghost-danger"><i class="ti ti-trash"></i> Sil</button></form>
                </div></td></tr>
            }
            </tbody></table></div>
        }
        else { <div class="empty admin-list-empty-state"><div class="empty-icon"><span class="avatar bg-primary-lt text-primary"><i class="ti ti-photo"></i></span></div><p class="empty-title">Henüz görsel eklenmedi.</p><p class="empty-subtitle text-secondary">İlk yüklenen görsel otomatik olarak kapak görseli olur.</p></div> }
    </section>
</div>
