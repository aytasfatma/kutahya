# Bu dosyayı ".env" olarak kopyalayıp gerçek değerleri girin. ".env" dosyası KAYNAK KONTROLÜNE
# EKLENMEMELİDİR (bkz. .gitignore). Buradaki değerler yalnızca örnektir, gerçek parola DEĞİLDİR.

# SQL Server "sa" kullanıcısı için güçlü bir parola (SQL Server minimum karmaşıklık kuralları
# geçerlidir: en az 8 karakter, büyük/küçük harf + rakam + sembol).
MSSQL_SA_PASSWORD=ChangeThisStrongPassword123!

# Geliştirme/demo admin kullanıcı seed'i (opsiyonel — boş bırakılırsa admin seed'i güvenli şekilde
# atlanır, bkz. IdentitySeeder). Production'da mutlaka güçlü, benzersiz bir parola kullanın.
SEED_ADMIN_EMAIL=admin@admin.com
SEED_ADMIN_PASSWORD=admin
ALLOW_WEAK_ADMIN_PASSWORD=true

# Kariyer başvurularını gönderecek doğrulanmış SMTP/Gmail hesabı. Normal Gmail parolası yerine
# Google uygulama şifresi kullanın. Alıcı adresi admin panelindeki Form Yönetimi > E-posta Ayarları'ndan yönetilir.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-with-google-app-password
SMTP_USE_TLS=true
